{
  "group": { "en": "Auction house bot", "ru": "Бот аукциона" },
  "hint": {
    "en": "A character that sells and buys at the auction houses. Set its account (and character) first; how many auctions it keeps is in the world table mod_auctionhousebot.",
    "ru": "Персонаж, который продаёт и покупает на аукционах. Сначала укажите его аккаунт (и персонажа); сколько лотов он держит, задаёт таблица мира mod_auctionhousebot."
  },
  "fields": [
    { "key": "AuctionHouseBot.Account", "type": "int", "min": 0, "default": 0, "apply": "reload",
      "label": { "en": "Bot account id", "ru": "Id аккаунта бота" },
      "hint": { "en": "Id of the account (auth.account) whose characters trade. 0 with character 0: the bot is off", "ru": "Id аккаунта (auth.account), чьи персонажи торгуют. 0 при персонаже 0: бот выключен" } },
    { "key": "AuctionHouseBot.GUID", "type": "int", "min": 0, "default": 0, "apply": "reload",
      "label": { "en": "Bot character guid", "ru": "Guid персонажа бота" },
      "hint": { "en": "Guid (characters.characters) of the one character that trades; 0: every character of the account", "ru": "Guid (characters.characters) единственного торгующего персонажа; 0: все персонажи аккаунта" } },
    { "key": "AuctionHouseBot.EnableSeller", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Bot puts items up for auction", "ru": "Бот выставляет товары" } },
    { "key": "AuctionHouseBot.EnableBuyer", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Bot buys players' auctions", "ru": "Бот покупает лоты игроков" } },
    { "key": "AuctionHouseBot.ItemsPerCycle", "type": "int", "min": 0, "default": 200, "apply": "reload",
      "label": { "en": "Items added or removed per cycle", "ru": "Предметов за цикл (добавить или снять)" } },
    { "key": "AuctionHouseBot.ElapsingTimeClass", "type": "choice", "default": 1, "apply": "reload",
      "label": { "en": "Auction duration", "ru": "Длительность лотов" },
      "options": [
        { "value": "0", "label": { "en": "Long: 1 to 3 days", "ru": "Долгие: от 1 до 3 дней" } },
        { "value": "1", "label": { "en": "Medium: 1 to 24 hours", "ru": "Средние: от 1 до 24 часов" } },
        { "value": "2", "label": { "en": "Short: 10 to 60 minutes", "ru": "Короткие: от 10 до 60 минут" } }
      ] },
    { "key": "AuctionHouseBot.UseMarketPriceForSeller", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Sell at market price", "ru": "Продавать по рыночной цене" } },
    { "key": "AuctionHouseBot.MarketResetThreshold", "type": "int", "min": 0, "default": 25, "apply": "reload",
      "label": { "en": "Auctions before the market price is adopted", "ru": "Лотов до принятия рыночной цены" },
      "hint": { "en": "Lower: prices react faster; higher: prices swing less", "ru": "Меньше: цены реагируют быстрее; больше: меньше колеблются" } },
    { "key": "AuctionHouseBot.UseBuyPriceForSeller", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Seller prices from the vendor buy price", "ru": "Цены продавца от цены покупки у торговца" },
      "hint": { "en": "Off: from the vendor sell price", "ru": "Выкл.: от цены продажи торговцу" } },
    { "key": "AuctionHouseBot.UseBuyPriceForBuyer", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Buyer prices from the vendor buy price", "ru": "Цены покупателя от цены покупки у торговца" },
      "hint": { "en": "Off: from the vendor sell price", "ru": "Выкл.: от цены продажи торговцу" } },
    { "key": "AuctionHouseBot.ConsiderOnlyBotAuctions", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Count only the bot's own auctions", "ru": "Считать только лоты бота" },
      "hint": { "en": "Players' auctions do not count towards the number of auctions the bot keeps", "ru": "Лоты игроков не входят в число лотов, которое держит бот" } },
    { "key": "AuctionHouseBot.DuplicatesCount", "type": "int", "min": 0, "default": 0, "apply": "reload",
      "label": { "en": "Most stacks of the same item", "ru": "Максимум стопок одного предмета" },
      "hint": { "en": "0: no limit", "ru": "0: без ограничения" } },
    { "key": "AuctionHouseBot.DivisibleStacks", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Stack sizes by the item's stack limit", "ru": "Размер стопок по лимиту стопки" },
      "hint": { "en": "An item that stacks to 20 is sold in stacks of 5, 10, 15 and 20", "ru": "Предмет со стопкой до 20 продаётся стопками по 5, 10, 15 и 20" } },
    { "key": "AuctionHouseBot.VendorItems", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Sell items vendors sell", "ru": "Продавать предметы торговцев" } },
    { "key": "AuctionHouseBot.VendorTradeGoods", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Sell trade goods vendors sell", "ru": "Продавать хозтовары торговцев" } },
    { "key": "AuctionHouseBot.LootItems", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Sell looted and fished items", "ru": "Продавать добычу и улов" } },
    { "key": "AuctionHouseBot.LootTradeGoods", "type": "bool", "default": 1, "apply": "reload",
      "label": { "en": "Sell looted and fished trade goods", "ru": "Продавать хозтовары из добычи и улова" } },
    { "key": "AuctionHouseBot.OtherItems", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Sell other items", "ru": "Продавать прочие предметы" } },
    { "key": "AuctionHouseBot.OtherTradeGoods", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Sell other trade goods", "ru": "Продавать прочие хозтовары" } },
    { "key": "AuctionHouseBot.ProfessionItems", "type": "bool", "default": 0, "apply": "reload",
      "label": { "en": "Sell items professions need", "ru": "Продавать предметы для профессий" } },
    { "key": "AuctionHouseBot.DisableItemsBelowReqLevel", "type": "int", "min": 0, "default": 0, "apply": "reload",
      "label": { "en": "No items below required level", "ru": "Без предметов ниже требуемого уровня" },
      "hint": { "en": "0: off", "ru": "0: выкл." } },
    { "key": "AuctionHouseBot.DisableItemsAboveReqLevel", "type": "int", "min": 0, "default": 0, "apply": "reload",
      "label": { "en": "No items above required level", "ru": "Без предметов выше требуемого уровня" },
      "hint": { "en": "0: off", "ru": "0: выкл." } },
    { "key": "AuctionHouseBot.SellerWhiteList", "type": "string", "default": "", "apply": "reload",
      "label": { "en": "Sell only these items", "ru": "Продавать только эти предметы" },
      "hint": { "en": "Item entries separated by commas (1, 2, 3); empty: all items the filters allow", "ru": "Номера предметов через запятую (1, 2, 3); пусто: все, что пропускают фильтры" } }
  ]
}
